{
  "name": "dsh-researchcraft",
  "version": "0.2.0",
  "description": "ResearchCraft as a DeepSeek Harness profile: DSH web UI and agent, scientific skills, lab notebook, specialist subagents.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./mcp-connectors": "./mcp-connectors.js",
    "./consensus-search": "./consensus-search.js",
    "./subagent-models": "./subagent-models.js",
    "./prompt-section": "./prompt-section.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "notebook.js",
    "notebook-export.js",
    "notebook-zip.js",
    "scientific-result.js",
    "image-generate.js",
    "image-gen-client.js",
    "image-gen-config.js",
    "sci-inspect.js",
    "latex-compile.js",
    "modal-run.js",
    "modal-instances.js",
    "runpod-run.js",
    "runpod-client.js",
    "runpod-instances.js",
    "workflows.js",
    "workflows.json",
    "credential-env.js",
    "settings-keys.js",
    "mcp-connectors.js",
    "consensus-search.js",
    "subagent-models.js",
    "prompt-section.js",
    "prompt.js",
    "seed.js",
    "cordis.patch.yml",
    "presets",
    "skills",
    "python-helpers",
    "lib",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raktim-mondol/dsh-researchcraft.git"
  },
  "homepage": "https://github.com/raktim-mondol/dsh-researchcraft#readme",
  "bugs": {
    "url": "https://github.com/raktim-mondol/dsh-researchcraft/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "node build-client.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "modal": "^0.8.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-system-prompt": "*"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "researchcraft"
  ]
}
